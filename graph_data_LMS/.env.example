# Optional environment variables (set them in your shell before `streamlit run app.py`).
# The app does not read this file automatically; it documents the available options.
# Nothing here is required: the lab works out of the box.

# Relocate all data (datasets, progress database, uploads) to another folder.
# Windows PowerShell:  $env:ANALYTICS_LAB_HOME = "D:\analytics-lab-data"
# macOS / Linux:       export ANALYTICS_LAB_HOME=~/analytics-lab-data
ANALYTICS_LAB_HOME=

# Streamlit server options (also configurable in .streamlit/config.toml), e.g. a different port:
STREAMLIT_SERVER_PORT=8501
